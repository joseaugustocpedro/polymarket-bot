# Example environment only. Copy to backend/.env and replace placeholders locally.
DATABASE_URL=sqlite:///./polymarket_bot.db
POLL_INTERVAL_SECONDS=30
ALERT_ON_BACKFILL=false

# Optional: keep disabled unless intentionally configuring notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Simulation defaults; no real trading enabled
PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
MAX_TRADE_USD=25
DAILY_LOSS_LIMIT_USD=50

# Optional monitored wallet seeds, example with a public address:
# DEFAULT_WALLETS=Example:0xYOUR_PUBLIC_WALLET_ADDRESS
